{
  "$ref": "#/definitions/CliReviewOutputV1",
  "definitions": {
    "CliReviewOutputV1": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "command": {
          "type": "string",
          "const": "review"
        },
        "reviewId": {
          "type": "string",
          "minLength": 1
        },
        "analysis": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "specificationId": {
              "type": "string",
              "minLength": 1
            },
            "specificationVersion": {
              "type": "integer",
              "minimum": 1
            },
            "approvedSnapshotId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["id", "specificationId", "specificationVersion", "approvedSnapshotId"],
          "additionalProperties": false
        },
        "target": {
          "type": "string",
          "enum": ["working-tree", "commit"]
        },
        "reviewSnapshotId": {
          "type": "string",
          "minLength": 1
        },
        "changedFiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "category": {
                "type": "string",
                "enum": [
                  "matched",
                  "missing",
                  "unexpected",
                  "divergent",
                  "unverifiable",
                  "accepted-deviation"
                ]
              },
              "nodeId": {
                "type": "string",
                "minLength": 1
              },
              "nodeName": {
                "type": "string",
                "minLength": 1
              },
              "requirementId": {
                "type": "string",
                "minLength": 1
              },
              "explanation": {
                "type": "string",
                "minLength": 1
              },
              "filePaths": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "acceptedDeviation": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["reason"],
                "additionalProperties": false
              }
            },
            "required": ["category", "nodeId", "nodeName", "explanation", "filePaths"],
            "additionalProperties": false
          }
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "requirementId": {
                "type": "string",
                "minLength": 1
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": ["implemented", "partially-implemented", "not-found", "unclear"]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "marker": {
                      "type": "string",
                      "enum": ["confirmed", "missing", "unclear"]
                    },
                    "note": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["marker", "note"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["requirementId", "statement", "status", "evidence"],
            "additionalProperties": false
          }
        },
        "edgeChanges": {
          "type": "object",
          "properties": {
            "added": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "removed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "omittedAdded": {
              "type": "integer",
              "minimum": 0
            },
            "omittedRemoved": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": ["added", "removed"],
          "additionalProperties": false
        },
        "ruleViolations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ruleId": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "filePaths": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "edgeId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["ruleId", "message", "filePaths"],
            "additionalProperties": false
          }
        },
        "discrepanciesFound": {
          "type": "boolean"
        },
        "breakdown": {
          "type": "object",
          "properties": {
            "correctlyPredictedStructural": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "missedChangedFiles": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "missedNewFiles": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "lexicalOnlyThatChanged": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["path", "name"],
                "additionalProperties": false
              }
            },
            "falseStrongPredictions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "likelihood": {
                    "type": "string",
                    "minLength": 1
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["path", "name", "likelihood", "basis"],
                "additionalProperties": false
              }
            },
            "unexpectedChanges": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "asyncOrBoundaryChanges": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "configurationAndAssetChanges": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "contractChanges": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "migrationChanges": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "nonGoalContradictions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "statement": {
                    "type": "string",
                    "minLength": 1
                  },
                  "changedPaths": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": ["statement", "changedPaths"],
                "additionalProperties": false
              }
            },
            "scope": {
              "type": "object",
              "properties": {
                "approvedSnapshotId": {
                  "type": "string",
                  "minLength": 1
                },
                "reviewSnapshotId": {
                  "type": "string",
                  "minLength": 1
                },
                "target": {
                  "type": "string",
                  "enum": ["working-tree", "commit"]
                },
                "changedFileCount": {
                  "type": "integer",
                  "minimum": 0
                },
                "indexedComponentCount": {
                  "type": "integer",
                  "minimum": 0
                },
                "limitations": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "approvedSnapshotId",
                "reviewSnapshotId",
                "target",
                "changedFileCount",
                "indexedComponentCount",
                "limitations"
              ],
              "additionalProperties": false
            },
            "confidence": {
              "type": "object",
              "properties": {
                "level": {
                  "type": "string",
                  "enum": ["high", "limited", "low"]
                },
                "reasons": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                }
              },
              "required": ["level", "reasons"],
              "additionalProperties": false
            }
          },
          "required": [
            "correctlyPredictedStructural",
            "missedChangedFiles",
            "missedNewFiles",
            "lexicalOnlyThatChanged",
            "falseStrongPredictions",
            "unexpectedChanges",
            "asyncOrBoundaryChanges",
            "configurationAndAssetChanges",
            "contractChanges",
            "migrationChanges",
            "nonGoalContradictions",
            "scope"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "command",
        "analysis",
        "target",
        "reviewSnapshotId",
        "changedFiles",
        "findings",
        "coverage",
        "edgeChanges",
        "ruleViolations",
        "discrepanciesFound"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
