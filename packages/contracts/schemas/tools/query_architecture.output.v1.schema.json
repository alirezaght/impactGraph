{
  "$ref": "#/definitions/Tool_query_architecture_OutputV1",
  "definitions": {
    "Tool_query_architecture_OutputV1": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "command": {
          "type": "string",
          "const": "architecture"
        },
        "snapshotId": {
          "type": "string",
          "minLength": 1
        },
        "workspaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "fileCount": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": ["name", "fileCount"],
            "additionalProperties": false
          }
        },
        "nodeCountsByType": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "edgeCountsByType": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "totalNodes": {
          "type": "integer",
          "minimum": 0
        },
        "totalEdges": {
          "type": "integer",
          "minimum": 0
        },
        "corrections": {
          "type": "object",
          "properties": {
            "renamed": {
              "type": "integer",
              "minimum": 0
            },
            "rolesSet": {
              "type": "integer",
              "minimum": 0
            },
            "contextsAssigned": {
              "type": "integer",
              "minimum": 0
            },
            "marked": {
              "type": "integer",
              "minimum": 0
            },
            "ownersSet": {
              "type": "integer",
              "minimum": 0
            },
            "confirmedRelationships": {
              "type": "integer",
              "minimum": 0
            },
            "rejectedRelationships": {
              "type": "integer",
              "minimum": 0
            },
            "merged": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "renamed",
            "rolesSet",
            "contextsAssigned",
            "marked",
            "confirmedRelationships",
            "rejectedRelationships",
            "merged"
          ],
          "additionalProperties": false
        },
        "effectiveTotalEdges": {
          "type": "integer",
          "minimum": 0
        },
        "rejectedEdges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "edgeId": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "level": {
                "type": "string",
                "enum": [
                  "human-confirmed",
                  "agent-approved",
                  "repo-metadata",
                  "deterministic-detection",
                  "ai-inferred",
                  "defaults"
                ]
              }
            },
            "required": ["edgeId", "level"],
            "additionalProperties": false
          }
        },
        "contexts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "memberCount": {
                "type": "integer",
                "minimum": 0
              },
              "samplePaths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": ["name", "memberCount"],
            "additionalProperties": false
          }
        },
        "repositories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "nodeCount": {
                "type": "integer",
                "minimum": 0
              },
              "fileCount": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": ["name", "nodeCount", "fileCount"],
            "additionalProperties": false
          }
        },
        "crossRepositoryEdges": {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "samples": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string",
                    "minLength": 1
                  },
                  "to": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "repositories": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 2,
                    "maxItems": 2
                  }
                },
                "required": ["from", "to", "type", "repositories"],
                "additionalProperties": false
              }
            }
          },
          "required": ["count", "samples"],
          "additionalProperties": false
        },
        "integrationPoints": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["name", "type"],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "command",
        "snapshotId",
        "workspaces",
        "packages",
        "nodeCountsByType",
        "edgeCountsByType",
        "totalNodes",
        "totalEdges"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
