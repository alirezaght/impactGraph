{
  "$ref": "#/definitions/Tool_get_workspace_status_OutputV1",
  "definitions": {
    "Tool_get_workspace_status_OutputV1": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "command": {
          "type": "string",
          "const": "status"
        },
        "initialized": {
          "type": "boolean"
        },
        "indexed": {
          "type": "boolean"
        },
        "snapshot": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "branch": {
              "type": "string"
            },
            "commitSha": {
              "type": "string",
              "minLength": 1
            },
            "dirtyWorkingTree": {
              "type": "boolean"
            },
            "createdAt": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["id", "commitSha", "dirtyWorkingTree", "createdAt"],
          "additionalProperties": false
        },
        "counts": {
          "type": "object",
          "properties": {
            "files": {
              "type": "integer",
              "minimum": 0
            },
            "nodes": {
              "type": "integer",
              "minimum": 0
            },
            "edges": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": ["files", "nodes", "edges"],
          "additionalProperties": false
        },
        "lastRun": {
          "type": "object",
          "properties": {
            "finishedAt": {
              "type": "string",
              "minLength": 1
            },
            "durationMs": {
              "type": "integer",
              "minimum": 0
            },
            "warningCount": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": ["finishedAt", "durationMs", "warningCount"],
          "additionalProperties": false
        }
      },
      "required": ["schemaVersion", "command", "initialized", "indexed"],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
