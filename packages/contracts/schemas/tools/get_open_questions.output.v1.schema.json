{
  "$ref": "#/definitions/Tool_get_open_questions_OutputV1",
  "definitions": {
    "Tool_get_open_questions_OutputV1": {
      "type": "object",
      "properties": {
        "specificationId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "openQuestions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string"
              },
              "affectedRequirementIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "severity": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "minLength": 1
              },
              "answer": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "question",
              "reason",
              "affectedRequirementIds",
              "severity",
              "status"
            ],
            "additionalProperties": false
          }
        },
        "readiness": {
          "type": "object",
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "blockingQuestions": {
              "type": "integer",
              "minimum": 0
            },
            "importantQuestions": {
              "type": "integer",
              "minimum": 0
            },
            "minorQuestions": {
              "type": "integer",
              "minimum": 0
            },
            "unmatchedRequirements": {
              "type": "integer",
              "minimum": 0
            },
            "recommendedAction": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "score",
            "blockingQuestions",
            "importantQuestions",
            "minorQuestions",
            "recommendedAction"
          ],
          "additionalProperties": false
        }
      },
      "required": ["specificationId", "version", "openQuestions", "readiness"],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
