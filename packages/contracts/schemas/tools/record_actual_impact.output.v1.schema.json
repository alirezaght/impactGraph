{
  "$ref": "#/definitions/Tool_record_actual_impact_OutputV1",
  "definitions": {
    "Tool_record_actual_impact_OutputV1": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "command": {
          "type": "string",
          "const": "record-actual-impact"
        },
        "outcomeId": {
          "type": "string",
          "minLength": 1
        },
        "analysisId": {
          "type": "string",
          "minLength": 1
        },
        "recordedAt": {
          "type": "string",
          "minLength": 1
        },
        "metrics": {
          "type": "object",
          "properties": {
            "analysisId": {
              "type": "string",
              "minLength": 1
            },
            "actualImpactId": {
              "type": "string",
              "minLength": 1
            },
            "precision": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "recall": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "truePositives": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "falsePositives": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "falseNegatives": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "rankingQuality": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "missedArtifactCategories": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "missedRelationshipTypes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "judgedTiers": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "required",
                  "likely",
                  "possible",
                  "lexical-only",
                  "unlikely",
                  "excluded"
                ]
              }
            },
            "falsePositiveBases": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "direct-structural",
                  "transitive-structural",
                  "async-event",
                  "external-contract",
                  "field-data-flow",
                  "configuration-asset",
                  "name-similarity",
                  "semantic-match",
                  "lexical-only"
                ]
              }
            }
          },
          "required": [
            "analysisId",
            "actualImpactId",
            "truePositives",
            "falsePositives",
            "falseNegatives",
            "missedArtifactCategories",
            "missedRelationshipTypes",
            "judgedTiers",
            "falsePositiveBases"
          ],
          "additionalProperties": false
        },
        "historyCount": {
          "type": "integer",
          "minimum": 1
        },
        "aggregate": {
          "type": "object",
          "properties": {
            "outcomeCount": {
              "type": "integer",
              "minimum": 0
            },
            "precision": {
              "type": "object",
              "properties": {
                "mean": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "sampleSize": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "mean",
                "sampleSize"
              ],
              "additionalProperties": false
            },
            "recall": {
              "$ref": "#/definitions/Tool_record_actual_impact_OutputV1/properties/aggregate/properties/precision"
            },
            "rankingQuality": {
              "$ref": "#/definitions/Tool_record_actual_impact_OutputV1/properties/aggregate/properties/precision"
            },
            "truePositiveCount": {
              "type": "integer",
              "minimum": 0
            },
            "falsePositiveCount": {
              "type": "integer",
              "minimum": 0
            },
            "falseNegativeCount": {
              "type": "integer",
              "minimum": 0
            },
            "topFalsePositiveBases": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string",
                    "minLength": 1
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "value",
                  "count"
                ],
                "additionalProperties": false
              }
            },
            "topMissedArtifactCategories": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Tool_record_actual_impact_OutputV1/properties/aggregate/properties/topFalsePositiveBases/items"
              }
            },
            "adrTriggerMet": {
              "type": "boolean"
            },
            "adrTriggerNote": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "outcomeCount",
            "truePositiveCount",
            "falsePositiveCount",
            "falseNegativeCount",
            "topFalsePositiveBases",
            "topMissedArtifactCategories",
            "adrTriggerMet"
          ],
          "additionalProperties": false
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schemaVersion",
        "command",
        "outcomeId",
        "analysisId",
        "recordedAt",
        "metrics",
        "historyCount",
        "note"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
