{
  "$ref": "#/definitions/GraphNodeArtifactV1",
  "definitions": {
    "GraphNodeArtifactV1": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 2
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "route": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "pathParameters": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "required": {
                    "type": "boolean"
                  }
                },
                "required": ["name", "required"],
                "additionalProperties": false
              }
            },
            "queryParameters": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/GraphNodeArtifactV1/properties/route/properties/pathParameters/items"
              }
            }
          },
          "required": ["path", "pathParameters", "queryParameters"],
          "additionalProperties": false
        },
        "knowledge": {
          "type": "object",
          "properties": {
            "provenance": {
              "type": "string",
              "enum": [
                "static-analysis",
                "configuration",
                "human-confirmed",
                "llm-inferred",
                "git-history",
                "framework-convention",
                "runtime-observation"
              ]
            },
            "evidenceIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "confidence": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "signals": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "minLength": 1
                      },
                      "contribution": {
                        "type": "number"
                      },
                      "description": {
                        "type": "string",
                        "maxLength": 1000
                      }
                    },
                    "required": ["type", "contribution"],
                    "additionalProperties": false
                  },
                  "minItems": 1
                }
              },
              "required": ["value", "signals"],
              "additionalProperties": false
            },
            "createdAt": {
              "type": "string",
              "minLength": 1
            },
            "repositorySnapshotId": {
              "type": "string",
              "minLength": 1
            },
            "analysisRunId": {
              "type": "string",
              "minLength": 1
            },
            "specification": {
              "type": "object",
              "properties": {
                "specificationId": {
                  "type": "string",
                  "minLength": 1
                },
                "specificationVersion": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": ["specificationId", "specificationVersion"],
              "additionalProperties": false
            }
          },
          "required": [
            "provenance",
            "evidenceIds",
            "confidence",
            "createdAt",
            "repositorySnapshotId",
            "analysisRunId"
          ],
          "additionalProperties": false
        }
      },
      "required": ["schemaVersion", "id", "category", "type", "name", "knowledge"],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
