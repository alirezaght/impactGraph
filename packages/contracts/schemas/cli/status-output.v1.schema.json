{
  "$ref": "#/definitions/CliStatusOutputV1",
  "definitions": {
    "CliStatusOutputV1": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "command": {
          "type": "string",
          "const": "status"
        },
        "initialized": {
          "type": "boolean"
        },
        "indexed": {
          "type": "boolean"
        },
        "snapshot": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "branch": {
              "type": "string"
            },
            "commitSha": {
              "type": "string",
              "minLength": 1
            },
            "dirtyWorkingTree": {
              "type": "boolean"
            },
            "createdAt": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "commitSha",
            "dirtyWorkingTree",
            "createdAt"
          ],
          "additionalProperties": false
        },
        "counts": {
          "type": "object",
          "properties": {
            "files": {
              "type": "integer",
              "minimum": 0
            },
            "nodes": {
              "type": "integer",
              "minimum": 0
            },
            "edges": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "files",
            "nodes",
            "edges"
          ],
          "additionalProperties": false
        },
        "lastRun": {
          "type": "object",
          "properties": {
            "finishedAt": {
              "type": "string",
              "minLength": 1
            },
            "durationMs": {
              "type": "integer",
              "minimum": 0
            },
            "warningCount": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "finishedAt",
            "durationMs",
            "warningCount"
          ],
          "additionalProperties": false
        },
        "repositories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "indexed": {
                "type": "boolean"
              },
              "fileCount": {
                "type": "integer",
                "minimum": 0
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "reasonCode": {
                "type": "string",
                "enum": [
                  "not-indexed",
                  "disabled",
                  "path-missing",
                  "path-outside-root"
                ]
              }
            },
            "required": [
              "name",
              "indexed",
              "fileCount"
            ],
            "additionalProperties": false
          }
        },
        "candidateRepositories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "hint": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "path",
              "hint"
            ],
            "additionalProperties": false
          }
        },
        "freshness": {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "current",
                "working-tree-modified",
                "behind-head",
                "specification-moved",
                "aged",
                "not-indexed"
              ]
            },
            "stale": {
              "type": "boolean"
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "indexedSnapshotId": {
              "type": "string",
              "minLength": 1
            },
            "indexedAt": {
              "type": "string",
              "minLength": 1
            },
            "currentCommitSha": {
              "type": "string",
              "minLength": 1
            },
            "recommendedAction": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "state",
            "stale",
            "reasons"
          ],
          "additionalProperties": false
        },
        "indexWarnings": {
          "type": "object",
          "properties": {
            "totalCount": {
              "type": "integer",
              "minimum": 0
            },
            "coverageLosingCount": {
              "type": "integer",
              "minimum": 0
            },
            "affectsPredictedArea": {
              "type": "boolean"
            },
            "groups": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "category": {
                    "type": "string",
                    "enum": [
                      "parse-failure",
                      "unsupported-syntax",
                      "unresolved-import",
                      "unresolved-symbol",
                      "ignored-file",
                      "missing-generated-file",
                      "external-dependency",
                      "stale-index",
                      "no-adapter",
                      "other"
                    ]
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "examplePaths": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "exampleMessage": {
                    "type": "string",
                    "minLength": 1
                  },
                  "affectsPredictedArea": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "category",
                  "count",
                  "examplePaths",
                  "affectsPredictedArea"
                ],
                "additionalProperties": false
              }
            },
            "sampled": {
              "type": "boolean"
            },
            "omittedWarningCount": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "totalCount",
            "coverageLosingCount",
            "affectsPredictedArea",
            "groups"
          ],
          "additionalProperties": false
        },
        "ignoredCount": {
          "type": "integer",
          "minimum": 0
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "server": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "command",
        "initialized",
        "indexed"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
