{
  "$ref": "#/definitions/RulesConfigV1",
  "definitions": {
    "RulesConfigV1": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "rules": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "type": "string",
                    "const": "dependency-direction"
                  },
                  "description": {
                    "type": "string"
                  },
                  "sourceRole": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sourceContext": {
                    "type": "string",
                    "minLength": 1
                  },
                  "forbiddenTargetRole": {
                    "type": "string",
                    "minLength": 1
                  },
                  "forbiddenTargetContext": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["id", "type"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "type": "string",
                    "const": "accompanying-change"
                  },
                  "description": {
                    "type": "string"
                  },
                  "whenChanged": {
                    "type": "string",
                    "minLength": 1
                  },
                  "requireChanged": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["id", "type", "whenChanged", "requireChanged"],
                "additionalProperties": false
              }
            ]
          }
        },
        "detections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "language": {
                "type": "string",
                "enum": ["typescript"]
              },
              "match": {
                "type": "object",
                "properties": {
                  "imports": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 3,
                      "pattern": "^[^*]+$"
                    },
                    "minItems": 1
                  },
                  "decorators": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "calls": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": ["imports"],
                "additionalProperties": false
              },
              "produces": {
                "type": "object",
                "properties": {
                  "nodeCategory": {
                    "type": "string",
                    "minLength": 1
                  },
                  "nodeType": {
                    "type": "string",
                    "minLength": 1
                  },
                  "nameArgument": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "edgeType": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["nodeCategory", "nodeType"],
                "additionalProperties": false
              }
            },
            "required": ["id", "language", "match", "produces"],
            "additionalProperties": false
          }
        }
      },
      "required": ["schemaVersion"],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
