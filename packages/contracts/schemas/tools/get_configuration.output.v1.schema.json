{
  "$ref": "#/definitions/Tool_get_configuration_OutputV1",
  "definitions": {
    "Tool_get_configuration_OutputV1": {
      "type": "object",
      "properties": {
        "config": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "type": "number",
              "const": 1
            },
            "ignore": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "disabledFrameworks": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "privacyMode": {
              "type": "string",
              "enum": ["local-only", "selected-snippets", "full-context", "external-agent"]
            },
            "provider": {
              "type": "object",
              "properties": {
                "strategy": {
                  "type": "string",
                  "enum": ["none", "external-agent", "anthropic", "openai-compatible", "local"]
                },
                "modelId": {
                  "type": "string",
                  "minLength": 1
                },
                "baseUrl": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["strategy"],
              "additionalProperties": false
            },
            "automation": {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": ["autonomous", "review", "manual"]
                },
                "safeOperations": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": ["mode"],
              "additionalProperties": false
            }
          },
          "required": ["schemaVersion"],
          "additionalProperties": false
        },
        "architecture": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "type": "number",
              "const": 1
            },
            "contexts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string"
                  },
                  "paths": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  },
                  "source": {
                    "type": "string",
                    "enum": ["human-confirmed", "agent-approved"]
                  }
                },
                "required": ["name", "paths"],
                "additionalProperties": false
              }
            },
            "components": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "role": {
                    "type": "string",
                    "minLength": 1
                  },
                  "context": {
                    "type": "string",
                    "minLength": 1
                  },
                  "markers": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": ["generated", "ignored", "infrastructure", "shared"]
                    },
                    "minItems": 1
                  },
                  "owner": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "source": {
                    "$ref": "#/definitions/Tool_get_configuration_OutputV1/properties/architecture/properties/contexts/items/properties/source"
                  }
                },
                "required": ["path"],
                "additionalProperties": false
              }
            },
            "renames": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string",
                    "minLength": 1
                  },
                  "to": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "confirmedAt": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source": {
                    "$ref": "#/definitions/Tool_get_configuration_OutputV1/properties/architecture/properties/contexts/items/properties/source"
                  }
                },
                "required": ["from", "to", "reason", "confirmedAt"],
                "additionalProperties": false
              }
            },
            "relationships": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "edgeId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "confirmed": {
                    "type": "boolean"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "confirmedAt": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source": {
                    "$ref": "#/definitions/Tool_get_configuration_OutputV1/properties/architecture/properties/contexts/items/properties/source"
                  }
                },
                "required": ["edgeId", "confirmed", "reason", "confirmedAt"],
                "additionalProperties": false
              }
            },
            "confirmations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "subjectKind": {
                    "type": "string",
                    "enum": [
                      "context",
                      "component",
                      "alias",
                      "exclusion",
                      "rule",
                      "detection",
                      "ignore"
                    ]
                  },
                  "subject": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "confirmedAt": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["subjectKind", "subject", "reason", "confirmedAt"],
                "additionalProperties": false
              }
            }
          },
          "required": ["schemaVersion"],
          "additionalProperties": false
        },
        "aliases": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "type": "number",
              "const": 1
            },
            "aliases": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "exclusions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "component": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["component"],
                "additionalProperties": false
              }
            }
          },
          "required": ["schemaVersion"],
          "additionalProperties": false
        },
        "rules": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "type": "number",
              "const": 1
            },
            "rules": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "type": {
                        "type": "string",
                        "const": "dependency-direction"
                      },
                      "description": {
                        "type": "string"
                      },
                      "sourceRole": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sourceContext": {
                        "type": "string",
                        "minLength": 1
                      },
                      "forbiddenTargetRole": {
                        "type": "string",
                        "minLength": 1
                      },
                      "forbiddenTargetContext": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": ["id", "type"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "type": {
                        "type": "string",
                        "const": "accompanying-change"
                      },
                      "description": {
                        "type": "string"
                      },
                      "whenChanged": {
                        "type": "string",
                        "minLength": 1
                      },
                      "requireChanged": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": ["id", "type", "whenChanged", "requireChanged"],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "detections": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string"
                  },
                  "language": {
                    "type": "string",
                    "enum": ["typescript"]
                  },
                  "match": {
                    "type": "object",
                    "properties": {
                      "imports": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 3,
                          "pattern": "^[^*]+$"
                        },
                        "minItems": 1
                      },
                      "decorators": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "calls": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "required": ["imports"],
                    "additionalProperties": false
                  },
                  "produces": {
                    "type": "object",
                    "properties": {
                      "nodeCategory": {
                        "type": "string",
                        "minLength": 1
                      },
                      "nodeType": {
                        "type": "string",
                        "minLength": 1
                      },
                      "nameArgument": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "edgeType": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": ["nodeCategory", "nodeType"],
                    "additionalProperties": false
                  }
                },
                "required": ["id", "language", "match", "produces"],
                "additionalProperties": false
              }
            }
          },
          "required": ["schemaVersion"],
          "additionalProperties": false
        }
      },
      "required": ["config", "architecture", "aliases", "rules"],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
