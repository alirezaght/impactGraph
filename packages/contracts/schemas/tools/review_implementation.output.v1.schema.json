{
  "$ref": "#/definitions/Tool_review_implementation_OutputV1",
  "definitions": {
    "Tool_review_implementation_OutputV1": {
      "type": "object",
      "properties": {
        "verdict": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": ["PASS", "NEEDS_ATTENTION"]
            },
            "headline": {
              "type": "string",
              "minLength": 1
            },
            "counts": {
              "type": "object",
              "properties": {
                "matched": {
                  "type": "integer",
                  "minimum": 0
                },
                "missing": {
                  "type": "integer",
                  "minimum": 0
                },
                "unexpected": {
                  "type": "integer",
                  "minimum": 0
                },
                "divergent": {
                  "type": "integer",
                  "minimum": 0
                },
                "reuseConfirmed": {
                  "type": "integer",
                  "minimum": 0
                },
                "unverifiable": {
                  "type": "integer",
                  "minimum": 0
                },
                "acceptedDeviations": {
                  "type": "integer",
                  "minimum": 0
                },
                "ruleViolations": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "matched",
                "missing",
                "unexpected",
                "divergent",
                "reuseConfirmed",
                "unverifiable",
                "acceptedDeviations",
                "ruleViolations"
              ],
              "additionalProperties": false
            },
            "decidingFindings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "category": {
                    "type": "string",
                    "minLength": 1
                  },
                  "nodeId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "explanation": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["category", "nodeId", "explanation"],
                "additionalProperties": false
              }
            },
            "truncatedFindingCounts": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "required": ["status", "headline", "counts", "decidingFindings"],
          "additionalProperties": false
        },
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "command": {
          "type": "string",
          "const": "review"
        },
        "reviewId": {
          "type": "string",
          "minLength": 1
        },
        "analysis": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "specificationId": {
              "type": "string",
              "minLength": 1
            },
            "specificationVersion": {
              "type": "integer",
              "minimum": 1
            },
            "approvedSnapshotId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["id", "specificationId", "specificationVersion", "approvedSnapshotId"],
          "additionalProperties": false
        },
        "baseline": {
          "type": "object",
          "properties": {
            "analysisId": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "type": "string",
              "enum": ["draft", "reviewed", "approved"]
            },
            "authority": {
              "type": "string",
              "enum": ["approved-contract", "unapproved-prediction"]
            },
            "snapshotId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["analysisId", "status", "authority", "snapshotId"],
          "additionalProperties": false
        },
        "target": {
          "type": "string",
          "enum": ["working-tree", "commit"]
        },
        "reviewSnapshotId": {
          "type": "string",
          "minLength": 1
        },
        "changedFiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "category": {
                "type": "string",
                "enum": [
                  "matched",
                  "missing",
                  "unexpected",
                  "divergent",
                  "reuse-confirmed",
                  "unverifiable",
                  "accepted-deviation"
                ]
              },
              "nodeId": {
                "type": "string",
                "minLength": 1
              },
              "nodeName": {
                "type": "string",
                "minLength": 1
              },
              "requirementId": {
                "type": "string",
                "minLength": 1
              },
              "explanation": {
                "type": "string",
                "minLength": 1
              },
              "filePaths": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "acceptedDeviation": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["reason"],
                "additionalProperties": false
              }
            },
            "required": ["category", "nodeId", "nodeName", "explanation", "filePaths"],
            "additionalProperties": false
          }
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "requirementId": {
                "type": "string",
                "minLength": 1
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": ["implemented", "partially-implemented", "not-found", "unclear"]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "marker": {
                      "type": "string",
                      "enum": ["confirmed", "missing", "unclear"]
                    },
                    "note": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["marker", "note"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["requirementId", "statement", "status", "evidence"],
            "additionalProperties": false
          }
        },
        "edgeChanges": {
          "type": "object",
          "properties": {
            "added": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "removed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "omittedAdded": {
              "type": "integer",
              "minimum": 0
            },
            "omittedRemoved": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": ["added", "removed"],
          "additionalProperties": false
        },
        "ruleViolations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ruleId": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "filePaths": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "edgeId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["ruleId", "message", "filePaths"],
            "additionalProperties": false
          }
        },
        "discrepanciesFound": {
          "type": "boolean"
        },
        "breakdown": {
          "type": "object",
          "properties": {
            "correctlyPredictedStructural": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "missedChangedFiles": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "missedNewFiles": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "lexicalOnlyThatChanged": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["path", "name"],
                "additionalProperties": false
              }
            },
            "falseStrongPredictions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "likelihood": {
                    "type": "string",
                    "minLength": 1
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["path", "name", "likelihood", "basis"],
                "additionalProperties": false
              }
            },
            "unexpectedChanges": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "asyncOrBoundaryChanges": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "configurationAndAssetChanges": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "contractChanges": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "migrationChanges": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "nonGoalContradictions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "statement": {
                    "type": "string",
                    "minLength": 1
                  },
                  "changedPaths": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": ["statement", "changedPaths"],
                "additionalProperties": false
              }
            },
            "scope": {
              "type": "object",
              "properties": {
                "approvedSnapshotId": {
                  "type": "string",
                  "minLength": 1
                },
                "reviewSnapshotId": {
                  "type": "string",
                  "minLength": 1
                },
                "target": {
                  "type": "string",
                  "enum": ["working-tree", "commit"]
                },
                "changedFileCount": {
                  "type": "integer",
                  "minimum": 0
                },
                "indexedComponentCount": {
                  "type": "integer",
                  "minimum": 0
                },
                "limitations": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "approvedSnapshotId",
                "reviewSnapshotId",
                "target",
                "changedFileCount",
                "indexedComponentCount",
                "limitations"
              ],
              "additionalProperties": false
            },
            "confidence": {
              "type": "object",
              "properties": {
                "level": {
                  "type": "string",
                  "enum": ["high", "limited", "low"]
                },
                "reasons": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                }
              },
              "required": ["level", "reasons"],
              "additionalProperties": false
            }
          },
          "required": [
            "correctlyPredictedStructural",
            "missedChangedFiles",
            "missedNewFiles",
            "lexicalOnlyThatChanged",
            "falseStrongPredictions",
            "unexpectedChanges",
            "asyncOrBoundaryChanges",
            "configurationAndAssetChanges",
            "contractChanges",
            "migrationChanges",
            "nonGoalContradictions",
            "scope"
          ],
          "additionalProperties": false
        },
        "drift": {
          "type": "object",
          "properties": {
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "edgeId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "edgeType": {
                    "type": "string",
                    "minLength": 1
                  },
                  "direction": {
                    "type": "string",
                    "enum": ["added", "removed"]
                  },
                  "category": {
                    "type": "string",
                    "enum": [
                      "cross-context",
                      "cross-repository",
                      "direction-reversal",
                      "new-dependency",
                      "removed-dependency",
                      "other"
                    ]
                  },
                  "from": {
                    "type": "object",
                    "properties": {
                      "nodeId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "nodeName": {
                        "type": "string",
                        "minLength": 1
                      },
                      "context": {
                        "type": "string",
                        "minLength": 1
                      },
                      "repository": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": ["nodeId", "nodeName"],
                    "additionalProperties": false
                  },
                  "to": {
                    "$ref": "#/definitions/Tool_review_implementation_OutputV1/properties/drift/properties/entries/items/properties/from"
                  }
                },
                "required": ["edgeId", "edgeType", "direction", "category", "from", "to"],
                "additionalProperties": false
              }
            },
            "omitted": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "category": {
                    "$ref": "#/definitions/Tool_review_implementation_OutputV1/properties/drift/properties/entries/items/properties/category"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": ["category", "count"],
                "additionalProperties": false
              }
            },
            "unmappedContexts": {
              "type": "object",
              "properties": {
                "contexts": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "omitted": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": ["contexts"],
              "additionalProperties": false
            }
          },
          "required": ["entries", "omitted"],
          "additionalProperties": false
        },
        "planContract": {
          "type": "object",
          "properties": {
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "blocking-constraint-violation",
                      "constraint-warning",
                      "runtime-topology-gap",
                      "invalid-assumption",
                      "config-semantics-risk",
                      "new-surface",
                      "coverage-gap",
                      "unresolved-architectural-question",
                      "missing-consumer",
                      "guard-not-updated",
                      "type-sensitive-comparison"
                    ]
                  },
                  "severity": {
                    "type": "string",
                    "enum": ["blocking", "warning", "informational"]
                  },
                  "requirementIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "statement": {
                    "type": "string",
                    "minLength": 1
                  },
                  "recommendation": {
                    "type": "string",
                    "minLength": 1
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "analyzer": {
                    "type": "string",
                    "minLength": 1
                  },
                  "constraintId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "proposedRelationship": {
                    "type": "object",
                    "properties": {
                      "sourceRef": {
                        "type": "string",
                        "minLength": 1
                      },
                      "relation": {
                        "type": "string",
                        "minLength": 1
                      },
                      "targetRef": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": ["sourceRef", "relation", "targetRef"],
                    "additionalProperties": false
                  },
                  "runtimePathId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "assumedSymbol": {
                    "type": "string",
                    "minLength": 1
                  },
                  "nodeIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "filePaths": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "severity",
                  "requirementIds",
                  "statement",
                  "recommendation",
                  "confidence",
                  "analyzer"
                ],
                "additionalProperties": false
              }
            },
            "unplannedPaths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "unchangedExpectedPaths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": ["findings", "unplannedPaths", "unchangedExpectedPaths"],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "command",
        "analysis",
        "target",
        "reviewSnapshotId",
        "changedFiles",
        "findings",
        "coverage",
        "edgeChanges",
        "ruleViolations",
        "discrepanciesFound"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
