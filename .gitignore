# Dependencies
node_modules/

# Build output
dist/
out/
build/
*.tsbuildinfo

# Test output
coverage/
.vscode-test/

# VS Code extension packaging
*.vsix

# Generated exports (`impactgraph graph` / `export_graph_html`) — derived output, never committed.
impactgraph-graph.html
impactgraph-impact.html
# Root-anchored: source directories named `reports/` (e.g. workspace-engine/src/reports) stay tracked.
/reports/

# ImpactGraph runtime caches (the derived SQLite index is disposable — ADR-0006).
# Committed .impactgraph/ config (YAML) stays tracked; only caches are ignored.
.impactgraph/cache/

# Environment files — never committed (privacy invariant, PRD §35)
.env
.env.*

# Logs
pnpm-debug.log*

# OS noise
.DS_Store
