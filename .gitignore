# Dependencies
node_modules/

# Build output
dist/
out/
build/
*.tsbuildinfo

# Test output
coverage/
.vscode-test/

# VS Code extension packaging
*.vsix

# ImpactGraph runtime caches (the derived SQLite index is disposable — ADR-0006).
