{
  "$ref": "#/definitions/GraphEdgeArtifactV1",
  "definitions": {
    "GraphEdgeArtifactV1": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "targetId": {
          "type": "string",
          "minLength": 1
        },
        "knowledge": {
          "type": "object",
          "properties": {
            "provenance": {
              "type": "string",
              "enum": [
                "static-analysis",
                "configuration",
                "human-confirmed",
                "llm-inferred",
                "git-history",
                "framework-convention",
                "runtime-observation"
              ]
            },
            "evidenceIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "confidence": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "signals": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "minLength": 1
                      },
                      "contribution": {
                        "type": "number"
                      },
                      "description": {
                        "type": "string",
                        "maxLength": 1000
                      }
                    },
                    "required": [
                      "type",
                      "contribution"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                }
              },
              "required": [
                "value",
                "signals"
              ],
              "additionalProperties": false
            },
            "createdAt": {
              "type": "string",
              "minLength": 1
            },
            "repositorySnapshotId": {
              "type": "string",
              "minLength": 1
            },
            "analysisRunId": {
              "type": "string",
              "minLength": 1
            },
            "specification": {
              "type": "object",
              "properties": {
                "specificationId": {
                  "type": "string",
                  "minLength": 1
                },
                "specificationVersion": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "specificationId",
                "specificationVersion"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "provenance",
            "evidenceIds",
            "confidence",
            "createdAt",
            "repositorySnapshotId",
            "analysisRunId"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "type",
        "sourceId",
        "targetId",
        "knowledge"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
