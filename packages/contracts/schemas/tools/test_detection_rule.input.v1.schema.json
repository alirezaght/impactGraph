{
  "$ref": "#/definitions/Tool_test_detection_rule_InputV1",
  "definitions": {
    "Tool_test_detection_rule_InputV1": {
      "type": "object",
      "properties": {
        "rule": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string"
            },
            "language": {
              "type": "string",
              "enum": ["typescript"]
            },
            "match": {
              "type": "object",
              "properties": {
                "imports": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 3,
                    "pattern": "^[^*]+$"
                  },
                  "minItems": 1
                },
                "decorators": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "calls": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": ["imports"],
              "additionalProperties": false
            },
            "produces": {
              "type": "object",
              "properties": {
                "nodeCategory": {
                  "type": "string",
                  "minLength": 1
                },
                "nodeType": {
                  "type": "string",
                  "minLength": 1
                },
                "nameArgument": {
                  "type": "integer",
                  "minimum": 0
                },
                "edgeType": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["nodeCategory", "nodeType"],
              "additionalProperties": false
            }
          },
          "required": ["id", "language", "match", "produces"],
          "additionalProperties": false
        },
        "snippet": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": ["rule"],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
